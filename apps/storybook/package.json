{
  "name": "@marisma/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:consumers": "playwright test --config playwright.consumers.config.ts",
    "test:brand": "playwright test --config playwright.brand.config.ts",
    "test:docs": "node --test tests-docs/documentation.test.mjs",
    "test:next": "playwright test --config playwright.next.config.ts",
    "test:visual": "playwright test --config playwright.config.ts tests/visuals.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@darizae/marisma": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@storybook/react-vite": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-a11y": "^10.5.6",
    "storybook": "^10.5.6",
    "vite": "^8.2.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "~6.0.3"
  }
}
